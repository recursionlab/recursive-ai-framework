    "formula": "λ(i→j) = λ_j_intrinsic + c·|[Oi,Oj]|",
    "decay_law": "D(t+1) = D(t)·exp(-λ_eff)",
    "effective_lambda": "mean(λ(k_t→k_{t+1}))"
  },

  "phase_portrait": {
    "attractors": {
      "J_equals_0": {
