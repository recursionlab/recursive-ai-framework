    "hard_constraints": [
      "Meta: max 2 consecutive",
      "Non after Meta: FORBIDDEN",
      "Para after Non: FORBIDDEN",
      "Ana at sequence end: FORBIDDEN"
    ],

    "termination": {
      "distance_threshold": 0.12,
      "max_path_length": 14
    }
  },

  "operator_algebra": {
    "commutator_formula": "[Oi,Oj] = Oi∘Oj - Oj∘Oi",
    "composition_notation": "∘",
    "note": "Commutator magnitudes will be computed from extracted operator compositions"
  }
